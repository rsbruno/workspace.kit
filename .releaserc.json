{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    [
      "@semantic-release/exec",
      {
        "prepareCmd": "npm pkg set version=${nextRelease.version} && bun run build && npm pack --silent && mv workspace-${nextRelease.version}.tgz workspace.tgz"
      }
    ],
    [
      "@semantic-release/github",
      {
        "assets": [{ "path": "workspace.tgz", "label": "workspace.tgz (npx / pnpm dlx)" }],
        "successComment": false,
        "failComment": false,
        "releasedLabels": false
      }
    ]
  ]
}
